{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strawberry Studios",
  "version": "0.1.0",
  "identifier": "com.strawberry.studios",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "beforeBuildCommand": "npm --prefix .. run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Strawberry Studios",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#0f1115"
      }
    ]
  },
  "bundle": {
    "active": true
  },
  "plugins": {}
}
